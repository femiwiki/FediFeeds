{
	"name": "FediFeeds",
	"author": "Femiwiki Team",
	"url": "https://github.com/femiwiki/FediFeeds",
	"descriptionmsg": "fedifeeds-desc",
	"license-name": "AGPL-3.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.46.0"
	},
	"MessagesDirs": {
		"FediFeeds": ["i18n"]
	},
	"ExtensionMessagesFiles": {
		"FediFeedsMagic": "FediFeeds.i18n.magic.php"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\FediFeeds\\Hooks"
		},
		"delivery": {
			"class": "MediaWiki\\Extension\\FediFeeds\\DeliveryHooks",
			"services": [
				"FediFeeds.Notes",
				"FediFeeds.Items",
				"FediFeeds.Followers",
				"PageStore",
				"ParserOutputAccess",
				"JobQueueGroup",
				"RevisionLookup"
			]
		},
		"pageDisplay": {
			"class": "MediaWiki\\Extension\\FediFeeds\\PageDisplayHooks",
			"services": ["FediFeeds.Notes", "PageStore"]
		},
		"schema": {
			"class": "MediaWiki\\Extension\\FediFeeds\\SchemaHooks"
		}
	},
	"Hooks": {
		"ParserFirstCallInit": "main",
		"BeforePageDisplay": "pageDisplay",
		"PageSaveComplete": "delivery",
		"LoadExtensionSchemaUpdates": "schema"
	},
	"JobClasses": {
		"fedifeedsDeliver": "MediaWiki\\Extension\\FediFeeds\\DeliveryJob"
	},
	"ServiceWiringFiles": ["includes/ServiceWiring.php"],
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\FediFeeds\\": "includes/"
	},
	"TestAutoloadNamespaces": {
		"MediaWiki\\Extension\\FediFeeds\\Tests\\": "tests/phpunit/"
	},
	"RestRoutes": [
		{
			"path": "/fedifeeds/actors/{handle}",
			"method": "GET",
			"class": "MediaWiki\\Extension\\FediFeeds\\Rest\\ActorHandler",
			"services": [
				"MainConfig",
				"PageStore",
				"TitleFormatter",
				"PageProps",
				"FediFeeds.LocalKeyStore"
			]
		},
		{
			"path": "/fedifeeds/webfinger",
			"method": "GET",
			"class": "MediaWiki\\Extension\\FediFeeds\\Rest\\WebFingerHandler",
			"services": ["MainConfig", "PageStore", "TitleFormatter", "PageProps"]
		},
		{
			"path": "/fedifeeds/actors/{handle}/notes/{item}",
			"method": "GET",
			"class": "MediaWiki\\Extension\\FediFeeds\\Rest\\NoteHandler",
			"services": ["FediFeeds.Notes", "PageStore"]
		},
		{
			"path": "/fedifeeds/actors/{handle}/outbox",
			"method": "GET",
			"class": "MediaWiki\\Extension\\FediFeeds\\Rest\\OutboxHandler",
			"services": ["FediFeeds.Notes", "PageStore"]
		},
		{
			"path": "/fedifeeds/actors/{handle}/followers",
			"method": "GET",
			"class": "MediaWiki\\Extension\\FediFeeds\\Rest\\FollowersHandler",
			"services": ["FediFeeds.Notes", "PageStore", "FediFeeds.Followers"]
		},
		{
			"path": "/fedifeeds/actors/{handle}/inbox",
			"method": "POST",
			"class": "MediaWiki\\Extension\\FediFeeds\\Rest\\FeedInboxHandler",
			"services": [
				"FediFeeds.Notes",
				"PageStore",
				"FediFeeds.RemoteKeys",
				"FediFeeds.Followers",
				"JobQueueGroup"
			]
		},
		{
			"path": "/fedifeeds/actors/inbox",
			"method": "POST",
			"class": "MediaWiki\\Extension\\FediFeeds\\Rest\\InboxHandler",
			"services": [
				"FediFeeds.Notes",
				"PageStore",
				"FediFeeds.RemoteKeys",
				"FediFeeds.Followers",
				"JobQueueGroup"
			]
		}
	],
	"config": {
		"FediFeedsActorBase": {
			"value": null,
			"description": "URL that a handle is appended to for the actor id, such as \"https://fedi.example.org/actors/\". The web server has to route it to the REST route /fedifeeds/actors/{handle}. Null uses that REST route directly."
		},
		"FediFeedsIcon": {
			"value": null,
			"description": "URL or path of the image every actor shows as its avatar, such as \"/images/feed.png\". It must be a raster image such as PNG, since Mastodon does not show SVG avatars. Null uses $wgAppleTouchIcon, else the first non-SVG of $wgLogos['1x'] and $wgLogos['icon'], else no icon."
		}
	},
	"manifest_version": 2
}
