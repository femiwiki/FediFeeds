{
	"name": "FediFeeds",
	"author": "Femiwiki Team",
	"url": "https://github.com/femiwiki/FediFeeds",
	"descriptionmsg": "fedifeeds-desc",
	"license-name": "AGPL-3.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.46.0"
	},
	"MessagesDirs": {
		"FediFeeds": ["i18n"]
	},
	"ExtensionMessagesFiles": {
		"FediFeedsMagic": "FediFeeds.i18n.magic.php"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\FediFeeds\\Hooks"
		},
		"pageDisplay": {
			"class": "MediaWiki\\Extension\\FediFeeds\\PageDisplayHooks",
			"services": ["FediFeeds.Notes", "PageStore"]
		}
	},
	"Hooks": {
		"ParserFirstCallInit": "main",
		"BeforePageDisplay": "pageDisplay"
	},
	"ServiceWiringFiles": ["includes/ServiceWiring.php"],
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\FediFeeds\\": "includes/"
	},
	"TestAutoloadNamespaces": {
		"MediaWiki\\Extension\\FediFeeds\\Tests\\": "tests/phpunit/"
	},
	"RestRoutes": [
		{
			"path": "/fedifeeds/actors/{handle}",
			"method": "GET",
			"class": "MediaWiki\\Extension\\FediFeeds\\Rest\\ActorHandler",
			"services": ["MainConfig", "PageStore", "TitleFormatter", "PageProps"]
		},
		{
			"path": "/fedifeeds/webfinger",
			"method": "GET",
			"class": "MediaWiki\\Extension\\FediFeeds\\Rest\\WebFingerHandler",
			"services": ["MainConfig", "PageStore", "TitleFormatter", "PageProps"]
		},
		{
			"path": "/fedifeeds/actors/{handle}/notes/{item}",
			"method": "GET",
			"class": "MediaWiki\\Extension\\FediFeeds\\Rest\\NoteHandler",
			"services": ["FediFeeds.Notes", "PageStore"]
		},
		{
			"path": "/fedifeeds/actors/{handle}/outbox",
			"method": "GET",
			"class": "MediaWiki\\Extension\\FediFeeds\\Rest\\OutboxHandler",
			"services": ["FediFeeds.Notes", "PageStore"]
		}
	],
	"config": {
		"FediFeedsActorBase": {
			"value": null,
			"description": "URL that a handle is appended to for the actor id, such as \"https://fedi.example.org/actors/\". The web server has to route it to the REST route /fedifeeds/actors/{handle}. Null uses that REST route directly."
		},
		"FediFeedsPrivateKeyPem": {
			"value": null,
			"description": "The PEM of the private key the wiki signs requests with. Every actor publishes the public key derived from it. Keep it out of version control. Null leaves publicKey out."
		}
	},
	"manifest_version": 2
}
