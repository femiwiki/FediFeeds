{
	"name": "femiwiki/fedifeeds",
	"description": "Lets the Fediverse follow feeds of a wiki.",
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/femiwiki/http-signatures",
			"no-api": true
		},
		{
			"type": "vcs",
			"url": "https://github.com/femiwiki/webfinger",
			"no-api": true
		}
	],
	"require": {
		"femiwiki/http-signatures": "1.0.0",
		"femiwiki/webfinger": "1.0.0"
	},
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "48.0.1",
		"mediawiki/mediawiki-phan-config": "0.20.0",
		"mediawiki/minus-x": "1.1.3",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0",
		"dealerdirect/phpcodesniffer-composer-installer": "1.2.1"
	},
	"scripts": {
		"fix": ["minus-x fix .", "phpcbf"],
		"test": [
			"parallel-lint . --exclude node_modules --exclude vendor",
			"phpcs -p -s",
			"minus-x check ."
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"license": "AGPL-3.0-or-later"
}
